{
  "name": "edupath",
  "version": "1.0.0",
  "private": true,
  "description": "EduPath — AI Career Navigation & Skill-Gap Agent",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "keywords": [
    "career-navigation",
    "ai-agent",
    "skill-graph",
    "proof-of-work",
    "editorial-brutalism"
  ],
  "author": "EduPath Systems",
  "license": "MIT"
}
