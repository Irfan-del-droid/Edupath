# ==================================================
# EduPath Environment Configuration
# ==================================================

# Port & Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Note: If unset or unreachable, EduPath automatically uses the built-in PGlite WASM engine for seamless zero-setup demo
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edupath

# Authentication
JWT_SECRET=edupath_editorial_jwt_secret_super_secure_key_2026

# AI / LLM Configuration
# Optional: If not provided, EduPath runs in high-fidelity deterministic heuristics evaluation mode
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-pro

# Supabase Storage (File & Object Storage ONLY)
# Optional: If not provided, EduPath stores uploaded files in server/uploads with full signed URLs
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=edupath-storage
